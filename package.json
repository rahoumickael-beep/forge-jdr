{
  "name": "forge-jdr",
  "version": "0.1.0",
  "private": true,
  "description": "Table de jeu de rôle en ligne : générateurs de scénarios, personnages et cartes, multijoueur en temps réel.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n serveur,client -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test shared/*.test.ts server/*.test.ts",
    "playtest": "node scripts/playtest.mjs",
    "verifier-secrets": "tsx scripts/verifier-secrets-client.ts",
    "livre": "tsx scripts/livre.ts dist-livre",
    "apercu-cartes": "node scripts/apercu-cartes.mjs",
    "livres": "tsx scripts/livres/index.ts tout dist-livre",
    "livres:impression": "tsx scripts/livres/index.ts tout dist-livre-impression --hd",
    "livres:archipel": "tsx scripts/livres/index.ts tout dist-livre --monde=archipel",
    "livres:ternelande": "tsx scripts/livres/index.ts tout dist-livre --monde=ternelande",
    "livres:residence": "tsx scripts/livres/index.ts tout dist-livre --monde=residence",
    "livres:noyes": "tsx scripts/livres/index.ts tout dist-livre --monde=noyes",
    "livres:sec": "tsx scripts/livres/index.ts tout dist-livre --monde=sec",
    "livres:asile": "tsx scripts/livres/index.ts tout dist-livre --monde=asile",
    "livres:iles": "tsx scripts/livres/index.ts tout dist-livre --monde=iles",
    "livres:expo": "tsx scripts/livres/index.ts tout dist-livre --monde=expo",
    "livres:hermes": "tsx scripts/livres/index.ts tout dist-livre --monde=hermes"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
